# copy to .env (docker compose reads it). The product is synthetic-only: no gateway keys, no LLM key, no channel provider.
DATABASE_URL=postgresql://recovery:recovery@postgres:5432/recovery
TEMPORAL_ADDRESS=temporal:7233

# the console and the simulated payment pages only run in demo mode
DEMO_MODE=true

# optional overrides (defaults in services/app/settings.py)
# REVENUE_TASK_QUEUE=revenue-q
# REVENUE_RESPONSE_TIMEOUT_S=900
# REVENUE_TIME_SCALE=100000
